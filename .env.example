# Copy this file to backend/.env (or keep it in the project root as .env) and fill in the values.
# NEVER commit the real file. It is listed in .gitignore.

# --- Nebius Token Factory (leave NEBIUS_API_KEY empty to run in clearly-labelled Demo Mode) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the EXACT model IDs from the Token Factory model list (or Playground > "view as code"). Do not guess them.
FAST_MODEL=        # NVIDIA Nemotron 3 Nano Omni: intake, photo analysis, duplicate judge, visual verification
VISION_MODEL=      # optional: defaults to FAST_MODEL
REASON_MODEL=      # NVIDIA Nemotron 3 Super: ambiguous routing, root-cause analysis

# --- Database: SQLite is used when this is empty. For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname ---
DATABASE_URL=

# --- Protects the job endpoints (/api/export, /api/hotspots). Leave empty to disable them. ---
EXPORT_TOKEN=

# --- Optional tuning ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5000000
RATE_LIMIT_PER_MINUTE=40
DAILY_TOKEN_BUDGET=300000
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
SEED_NEW_WORKSPACES=true
# FORCE_DEMO_MODE=true     # uncomment to ignore the key and run in Demo Mode (used by the tests)

# --- Frontend on a different address (Vercel + Render): list EVERY website address allowed to call the API ---
# CORS_ORIGINS=https://your-site.vercel.app              (https, no trailing slash, exact spelling; separate several with commas)
# CORS_ORIGIN_REGEX=https://your-site(-[a-z0-9-]+)?\.vercel\.app    (optional: also allow Vercel preview deployments)
# WORKSPACE_TTL_DAYS=14    # demo sandboxes untouched this long are deleted (0 = never)

# --- Hardening (see docs/deployment-guide.md) ---
# TRUST_PROXY_HOPS=1       # number of reverse proxies in front of the app (0 when running locally)
# DISABLE_DOCS=true        # hide /docs, /redoc and /openapi.json on a public site
# MAX_IMAGE_PIXELS=25000000
# CSP_MODE=report-only     # report-only (default, never breaks the site) | enforce | off
# CSP_EXTRA_CONNECT=       # API origin if the frontend is hosted on a different domain
